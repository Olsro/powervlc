Make net/if.h usable on Mac OS X 10.4 (+ fallback IFNAMSIZ)

On Mac OS X 10.4 the net/if.h header is not self-contained (it needs
<sys/socket.h> first for struct sockaddr): include it beforehand, so
that HAVE_NET_IF_H (forced by rules.mak, since configure's standalone
AC_CHECK_HEADERS probe fails) actually works — libnfs-sync.c needs
struct ifconf from it. Keep a fallback IFNAMSIZ for safety.

--- a/include/libnfs-private.h
+++ b/include/libnfs-private.h
@@ -26,6 +26,11 @@
 #ifdef HAVE_NET_IF_H
+#include <sys/socket.h>  /* 10.4: net/if.h is not self-contained */
 #include <net/if.h>
 #endif
+
+#ifndef IFNAMSIZ
+#define IFNAMSIZ 16
+#endif

 #if !defined(WIN32) && !defined(PS2_EE)
 #include <sys/socket.h>  /* struct sockaddr_storage */
