 /* Flag to indicate initialization
  */
+#if defined(__APPLE__) &&                                     \
+	defined(__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__) && \
+	__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ < 1070
+/* No compiler TLS on Mac OS X < 10.7: emulate it with a pthread key.
+ * The slot is heap-allocated per thread and freed by the key destructor. */
+#include <pthread.h>
+static pthread_key_t rnd_initialized_key;
+static pthread_once_t rnd_initialized_once = PTHREAD_ONCE_INIT;
+
+static void rnd_initialized_key_create(void)
+{
+	(void)pthread_key_create(&rnd_initialized_key, free);
+}
+
+static unsigned *rnd_initialized_slot(void)
+{
+	unsigned *slot;
+
+	pthread_once(&rnd_initialized_once, rnd_initialized_key_create);
+	slot = pthread_getspecific(rnd_initialized_key);
+	if (slot == NULL) {
+		slot = calloc(1, sizeof(*slot));
+		if (slot == NULL || pthread_setspecific(rnd_initialized_key, slot))
+			abort();
+	}
+	return slot;
+}
+#define rnd_initialized (*rnd_initialized_slot())
+#else
 static _Thread_local unsigned rnd_initialized = 0;
+#endif
 
