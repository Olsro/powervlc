--- a/lib/audit.c
+++ b/lib/audit.c
@@ -25,7 +25,38 @@
 #define CRAU_CONTEXT_STACK_DEPTH 8
 #include "audit.h"
 
+#if defined(__APPLE__) &&                                     \
+	defined(__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__) && \
+	__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ < 1070
+/* No compiler TLS on Mac OS X < 10.7: emulate it with a pthread key.
+ * The slot is heap-allocated per thread and freed by the key destructor. */
+#include <pthread.h>
+#include <stdlib.h>
+static pthread_key_t crau_stack_key;
+static pthread_once_t crau_stack_once = PTHREAD_ONCE_INIT;
+
+static void crau_stack_key_create(void)
+{
+	(void)pthread_key_create(&crau_stack_key, free);
+}
+
+static struct crau_context_stack_st *crau_stack_slot(void)
+{
+	struct crau_context_stack_st *slot;
+
+	pthread_once(&crau_stack_once, crau_stack_key_create);
+	slot = pthread_getspecific(crau_stack_key);
+	if (slot == NULL) {
+		slot = calloc(1, sizeof(*slot));
+		if (slot == NULL || pthread_setspecific(crau_stack_key, slot))
+			abort();
+	}
+	return slot;
+}
+#define stack (*crau_stack_slot())
+#else
 static _Thread_local struct crau_context_stack_st stack;
+#endif
 
