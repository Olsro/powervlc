 struct addrinfo *afp_get_address(void * priv, const char * hostname,
                                  unsigned int port)
 {
+#if defined(__APPLE__) && MAC_OS_X_VERSION_MIN_REQUIRED < 1040
+    struct in_addr ipv4;
+    struct hostent *host = NULL;
+
+    if (inet_aton(hostname, &ipv4) == 0) {
+        host = gethostbyname(hostname);
+        if (host == NULL || host->h_addrtype != AF_INET || host->h_length != sizeof(ipv4)) {
+            log_for_client(priv, AFPFSD, LOG_ERR,
+                           "Could not resolve %s.", hostname);
+            return NULL;
+        }
+        memcpy(&ipv4, host->h_addr_list[0], sizeof(ipv4));
+    }
+
+    struct addrinfo *numeric = calloc(1, sizeof(*numeric));
+    struct sockaddr_in *socket_address = calloc(1, sizeof(*socket_address));
+    if (numeric == NULL || socket_address == NULL) {
+        free(numeric);
+        free(socket_address);
+        errno = ENOMEM;
+        return NULL;
+    }
+
+    socket_address->sin_family = AF_INET;
+    socket_address->sin_port = htons(port);
+    socket_address->sin_addr = ipv4;
+    numeric->ai_family = AF_INET;
+    numeric->ai_socktype = SOCK_STREAM;
+    numeric->ai_protocol = IPPROTO_TCP;
+    numeric->ai_addrlen = sizeof(*socket_address);
+    numeric->ai_addr = (struct sockaddr *)socket_address;
+    return numeric;
+#else
     char port_string[6];
     struct addrinfo hints;
     struct addrinfo * addresses;
@@ -45,6 +80,7 @@
     }

     return addresses;
+#endif
 }


