+/* Two-pass 32x32 add: same layout with four 8-column groups. */
+static void idct_idct_32x32_core_altivec(uint8_t *dst, ptrdiff_t stride,
+                                         int16_t *block)
+{
+    vec_s16 tmp[4][32], c[32];
+    int g, h, k, m;
+
+    for (g = 0; g < 4; g++) {
+        for (k = 0; k < 32; k++)
+            c[k] = vec_ld(k * 64 + g * 16, block);
+        idct32_1d_altivec(c);
+        for (k = 0; k < 32; k++)
+            tmp[g][k] = c[k];
+    }
+    memset(block, 0, 32 * 32 * sizeof(int16_t));
+    for (h = 0; h < 4; h++) {
+        for (m = 0; m < 4; m++) {
+            for (k = 0; k < 8; k++)
+                c[8 * m + k] = tmp[m][8 * h + k];
+            transpose8x8_s16(&c[8 * m + 0], &c[8 * m + 1],
+                             &c[8 * m + 2], &c[8 * m + 3],
+                             &c[8 * m + 4], &c[8 * m + 5],
+                             &c[8 * m + 6], &c[8 * m + 7]);
+        }
+        idct32_1d_altivec(c);
+        for (k = 0; k < 32; k++)
+            add_store8_row6(dst + k * stride + 8 * h, c[k]);
+    }
+}
