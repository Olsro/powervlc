 /* ---- 4x4 inverse transforms (idct/iadst/iwht, all txtp combos) ----
  *
  * These reproduce, bit-for-bit, the C reference in vp9dsp_template.c
@@ -2290,6 +2263,648 @@ static void idct_idct_8x8_add_altivec(uint8_t *dst, ptrdiff_t stride,
     idct_idct_8x8_core_altivec(dst, stride, block, eob);
 }
 
+/* ---- 16x16 / 32x32 inverse transforms ----
+ *
+ * Same contract as the 8x8 block above: bit-for-bit the C reference
+ * (idct16_1d / iadst16_1d / idct32_1d under itxfm_wrapper), 8-bit only.
+ * A 1D pass runs on 8 of the N columns at a time (vector k = IN(k) of
+ * the 8 parallel column transforms), on the 8x8 section's s32x8
+ * multiply helpers.  Unlike the 8x8 code, every value is narrowed back
+ * to int16 right after its (+ (1 << 13)) >> 14 rounding and the
+ * butterflies run as plain (wrapping) int16 adds - the same layout the
+ * aarch64 NEON version keeps in its .8h registers, and legal for the
+ * same reason the narrowing points there are: the C reference stores
+ * every rounded value and every butterfly result into int16 tmp[]
+ * arrays or feeds it to a later int16-operand multiply, so on any
+ * input the C reference handles they all fit int16 and the int16
+ * arithmetic here is exact.  Unrounded products (iadst16's first and
+ * third multiply blocks) stay in s32x8 exactly like the C's t0..t15,
+ * whose sums stay below 2^31 for all coefficient pairs used.
+ *
+ * Two-pass wrapper layout: pass a runs on each 8-column group g of the
+ * input, and its output vector k (holding out[k] of columns
+ * 8g..8g+7) is kept as scratch tmp[g][k]; in C terms lane j of
+ * tmp[g][k] is tmp_C[(8g+j)*N + k].  Pass b's transform i needs
+ * IN(x) = tmp_C[x*N + i], so each 8-transform output group h gathers
+ * its inputs by 8x8-transposing the scratch vectors tmp[m][8h..8h+7]
+ * into input vectors c[8m..8m+7], then adds its outputs to dst columns
+ * 8h..8h+7 (one 8-wide half-row store per row). */
+
+/* pack(rnd14(a*ca + b*cb)) and friends; operands int16, products and
+ * their sum int32 (|a*ca + b*cb| < 2^31 for every coefficient pair
+ * used here, so the s32x8 accumulation is exact). */
+static av_always_inline vec_s16 dmul_add_p(vec_s16 a, vec_s16 ca,
+                                           vec_s16 b, vec_s16 cb)
+{
+    return pack_eo(rnd14x8(add8(mul8(a, ca), mul8(b, cb))));
+}
+
+static av_always_inline vec_s16 dmul_sub_p(vec_s16 a, vec_s16 ca,
+                                           vec_s16 b, vec_s16 cb)
+{
+    return pack_eo(rnd14x8(sub8(mul8(a, ca), mul8(b, cb))));
+}
+
+/* pack((-(a*ca + b*cb) + (1 << 13)) >> 14): negation before the
+ * rounding add, exactly as at the C's -(x*C1 + y*C2) sites. */
+static av_always_inline vec_s16 dmul_nadd_p(vec_s16 a, vec_s16 ca,
+                                            vec_s16 b, vec_s16 cb)
+{
+    return pack_eo(rnd14x8(neg8(add8(mul8(a, ca), mul8(b, cb)))));
+}
+
+static av_always_inline vec_s16 smul_p(vec_s16 a, vec_s16 c)
+{
+    return pack_eo(rnd14x8(mul8(a, c)));
+}
+
+/* pack((-(a*c) + (1 << 13)) >> 14), negation before the rounding add. */
+static av_always_inline vec_s16 smul_np(vec_s16 a, vec_s16 c)
+{
+    return pack_eo(rnd14x8(neg8(mul8(a, c))));
+}
+
+static av_always_inline vec_s16 neg16(vec_s16 a)
+{
+    return vec_sub(vec_splat_s16(0), a);
+}
+
+/* One idct16 1D pass on the sixteen input vectors c[0..15] (in place).
+ * Mirrors idct16_1d() statement for statement. */
+static av_always_inline void idct16_1d_altivec(vec_s16 *c)
+{
+    const vec_s16 k11585 = VSPLAT16(11585);
+    const vec_s16 k6270  = VSPLAT16(6270);
+    const vec_s16 k15137 = VSPLAT16(15137);
+    const vec_s16 k3196  = VSPLAT16(3196);
+    const vec_s16 k16069 = VSPLAT16(16069);
+    const vec_s16 k13623 = VSPLAT16(13623);
+    const vec_s16 k9102  = VSPLAT16(9102);
+    const vec_s16 k1606  = VSPLAT16(1606);
+    const vec_s16 k16305 = VSPLAT16(16305);
+    const vec_s16 k12665 = VSPLAT16(12665);
+    const vec_s16 k10394 = VSPLAT16(10394);
+    const vec_s16 k7723  = VSPLAT16(7723);
+    const vec_s16 k14449 = VSPLAT16(14449);
+    const vec_s16 k15679 = VSPLAT16(15679);
+    const vec_s16 k4756  = VSPLAT16(4756);
+
+    vec_s16 t0a  = dmul_add_p(c[0],  k11585, c[8],  k11585);
+    vec_s16 t1a  = dmul_sub_p(c[0],  k11585, c[8],  k11585);
+    vec_s16 t2a  = dmul_sub_p(c[4],  k6270,  c[12], k15137);
+    vec_s16 t3a  = dmul_add_p(c[4],  k15137, c[12], k6270);
+    vec_s16 t4a  = dmul_sub_p(c[2],  k3196,  c[14], k16069);
+    vec_s16 t7a  = dmul_add_p(c[2],  k16069, c[14], k3196);
+    vec_s16 t5a  = dmul_sub_p(c[10], k13623, c[6],  k9102);
+    vec_s16 t6a  = dmul_add_p(c[10], k9102,  c[6],  k13623);
+    vec_s16 t8a  = dmul_sub_p(c[1],  k1606,  c[15], k16305);
+    vec_s16 t15a = dmul_add_p(c[1],  k16305, c[15], k1606);
+    vec_s16 t9a  = dmul_sub_p(c[9],  k12665, c[7],  k10394);
+    vec_s16 t14a = dmul_add_p(c[9],  k10394, c[7],  k12665);
+    vec_s16 t10a = dmul_sub_p(c[5],  k7723,  c[11], k14449);
+    vec_s16 t13a = dmul_add_p(c[5],  k14449, c[11], k7723);
+    vec_s16 t11a = dmul_sub_p(c[13], k15679, c[3],  k4756);
+    vec_s16 t12a = dmul_add_p(c[13], k4756,  c[3],  k15679);
+
+    vec_s16 t0  = vec_add(t0a,  t3a);
+    vec_s16 t1  = vec_add(t1a,  t2a);
+    vec_s16 t2  = vec_sub(t1a,  t2a);
+    vec_s16 t3  = vec_sub(t0a,  t3a);
+    vec_s16 t4  = vec_add(t4a,  t5a);
+    vec_s16 t5  = vec_sub(t4a,  t5a);
+    vec_s16 t6  = vec_sub(t7a,  t6a);
+    vec_s16 t7  = vec_add(t7a,  t6a);
+    vec_s16 t8  = vec_add(t8a,  t9a);
+    vec_s16 t9  = vec_sub(t8a,  t9a);
+    vec_s16 t10 = vec_sub(t11a, t10a);
+    vec_s16 t11 = vec_add(t11a, t10a);
+    vec_s16 t12 = vec_add(t12a, t13a);
+    vec_s16 t13 = vec_sub(t12a, t13a);
+    vec_s16 t14 = vec_sub(t15a, t14a);
+    vec_s16 t15 = vec_add(t15a, t14a);
+
+    t5a  = smul_p(vec_sub(t6, t5), k11585);
+    t6a  = smul_p(vec_add(t6, t5), k11585);
+    t9a  = dmul_sub_p(t14, k6270,  t9,  k15137);
+    t14a = dmul_add_p(t14, k15137, t9,  k6270);
+    t10a = dmul_nadd_p(t13, k15137, t10, k6270);
+    t13a = dmul_sub_p(t13, k6270,  t10, k15137);
+
+    t0a  = vec_add(t0, t7);
+    t1a  = vec_add(t1, t6a);
+    t2a  = vec_add(t2, t5a);
+    t3a  = vec_add(t3, t4);
+    t4   = vec_sub(t3, t4);
+    t5   = vec_sub(t2, t5a);
+    t6   = vec_sub(t1, t6a);
+    t7   = vec_sub(t0, t7);
+    t8a  = vec_add(t8, t11);
+    t9   = vec_add(t9a, t10a);
+    t10  = vec_sub(t9a, t10a);
+    t11a = vec_sub(t8, t11);
+    t12a = vec_sub(t15, t12);
+    t13  = vec_sub(t14a, t13a);
+    t14  = vec_add(t14a, t13a);
+    t15a = vec_add(t15, t12);
+
+    t10a = smul_p(vec_sub(t13,  t10),  k11585);
+    t13a = smul_p(vec_add(t13,  t10),  k11585);
+    t11  = smul_p(vec_sub(t12a, t11a), k11585);
+    t12  = smul_p(vec_add(t12a, t11a), k11585);
+
+    c[0]  = vec_add(t0a, t15a);
+    c[1]  = vec_add(t1a, t14);
+    c[2]  = vec_add(t2a, t13a);
+    c[3]  = vec_add(t3a, t12);
+    c[4]  = vec_add(t4,  t11);
+    c[5]  = vec_add(t5,  t10a);
+    c[6]  = vec_add(t6,  t9);
+    c[7]  = vec_add(t7,  t8a);
+    c[8]  = vec_sub(t7,  t8a);
+    c[9]  = vec_sub(t6,  t9);
+    c[10] = vec_sub(t5,  t10a);
+    c[11] = vec_sub(t4,  t11);
+    c[12] = vec_sub(t3a, t12);
+    c[13] = vec_sub(t2a, t13a);
+    c[14] = vec_sub(t1a, t14);
+    c[15] = vec_sub(t0a, t15a);
+}
+
+/* One iadst16 1D pass on c[0..15] (in place).  Mirrors iadst16_1d():
+ * the first and third multiply blocks stay unrounded s32x8 like the
+ * C's t0..t15, negations happen exactly where the C negates (before
+ * or after the rounding shift, per site). */
+static av_always_inline void iadst16_1d_altivec(vec_s16 *c)
+{
+    const vec_s16 k16364 = VSPLAT16(16364);
+    const vec_s16 k804   = VSPLAT16(804);
+    const vec_s16 k15893 = VSPLAT16(15893);
+    const vec_s16 k3981  = VSPLAT16(3981);
+    const vec_s16 k14811 = VSPLAT16(14811);
+    const vec_s16 k7005  = VSPLAT16(7005);
+    const vec_s16 k13160 = VSPLAT16(13160);
+    const vec_s16 k9760  = VSPLAT16(9760);
+    const vec_s16 k11003 = VSPLAT16(11003);
+    const vec_s16 k12140 = VSPLAT16(12140);
+    const vec_s16 k8423  = VSPLAT16(8423);
+    const vec_s16 k14053 = VSPLAT16(14053);
+    const vec_s16 k5520  = VSPLAT16(5520);
+    const vec_s16 k15426 = VSPLAT16(15426);
+    const vec_s16 k2404  = VSPLAT16(2404);
+    const vec_s16 k16207 = VSPLAT16(16207);
+    const vec_s16 k16069 = VSPLAT16(16069);
+    const vec_s16 k3196  = VSPLAT16(3196);
+    const vec_s16 k9102  = VSPLAT16(9102);
+    const vec_s16 k13623 = VSPLAT16(13623);
+    const vec_s16 k15137 = VSPLAT16(15137);
+    const vec_s16 k6270  = VSPLAT16(6270);
+    const vec_s16 k11585 = VSPLAT16(11585);
+
+    s32x8 T0  = add8(mul8(c[15], k16364), mul8(c[0],  k804));
+    s32x8 T1  = sub8(mul8(c[15], k804),   mul8(c[0],  k16364));
+    s32x8 T2  = add8(mul8(c[13], k15893), mul8(c[2],  k3981));
+    s32x8 T3  = sub8(mul8(c[13], k3981),  mul8(c[2],  k15893));
+    s32x8 T4  = add8(mul8(c[11], k14811), mul8(c[4],  k7005));
+    s32x8 T5  = sub8(mul8(c[11], k7005),  mul8(c[4],  k14811));
+    s32x8 T6  = add8(mul8(c[9],  k13160), mul8(c[6],  k9760));
+    s32x8 T7  = sub8(mul8(c[9],  k9760),  mul8(c[6],  k13160));
+    s32x8 T8  = add8(mul8(c[7],  k11003), mul8(c[8],  k12140));
+    s32x8 T9  = sub8(mul8(c[7],  k12140), mul8(c[8],  k11003));
+    s32x8 T10 = add8(mul8(c[5],  k8423),  mul8(c[10], k14053));
+    s32x8 T11 = sub8(mul8(c[5],  k14053), mul8(c[10], k8423));
+    s32x8 T12 = add8(mul8(c[3],  k5520),  mul8(c[12], k15426));
+    s32x8 T13 = sub8(mul8(c[3],  k15426), mul8(c[12], k5520));
+    s32x8 T14 = add8(mul8(c[1],  k2404),  mul8(c[14], k16207));
+    s32x8 T15 = sub8(mul8(c[1],  k16207), mul8(c[14], k2404));
+
+    {
+        vec_s16 t0a  = pack_eo(rnd14x8(add8(T0, T8)));
+        vec_s16 t1a  = pack_eo(rnd14x8(add8(T1, T9)));
+        vec_s16 t2a  = pack_eo(rnd14x8(add8(T2, T10)));
+        vec_s16 t3a  = pack_eo(rnd14x8(add8(T3, T11)));
+        vec_s16 t4a  = pack_eo(rnd14x8(add8(T4, T12)));
+        vec_s16 t5a  = pack_eo(rnd14x8(add8(T5, T13)));
+        vec_s16 t6a  = pack_eo(rnd14x8(add8(T6, T14)));
+        vec_s16 t7a  = pack_eo(rnd14x8(add8(T7, T15)));
+        vec_s16 t8a  = pack_eo(rnd14x8(sub8(T0, T8)));
+        vec_s16 t9a  = pack_eo(rnd14x8(sub8(T1, T9)));
+        vec_s16 t10a = pack_eo(rnd14x8(sub8(T2, T10)));
+        vec_s16 t11a = pack_eo(rnd14x8(sub8(T3, T11)));
+        vec_s16 t12a = pack_eo(rnd14x8(sub8(T4, T12)));
+        vec_s16 t13a = pack_eo(rnd14x8(sub8(T5, T13)));
+        vec_s16 t14a = pack_eo(rnd14x8(sub8(T6, T14)));
+        vec_s16 t15a = pack_eo(rnd14x8(sub8(T7, T15)));
+
+        vec_s16 t0, t1, t2, t3, t4, t5, t6, t7, t10, t11;
+
+        T8  = add8(mul8(t8a,  k16069), mul8(t9a,  k3196));
+        T9  = sub8(mul8(t8a,  k3196),  mul8(t9a,  k16069));
+        T10 = add8(mul8(t10a, k9102),  mul8(t11a, k13623));
+        T11 = sub8(mul8(t10a, k13623), mul8(t11a, k9102));
+        T12 = sub8(mul8(t13a, k16069), mul8(t12a, k3196));
+        T13 = add8(mul8(t13a, k3196),  mul8(t12a, k16069));
+        T14 = sub8(mul8(t15a, k9102),  mul8(t14a, k13623));
+        T15 = add8(mul8(t15a, k13623), mul8(t14a, k9102));
+
+        t0 = vec_add(t0a, t4a);
+        t1 = vec_add(t1a, t5a);
+        t2 = vec_add(t2a, t6a);
+        t3 = vec_add(t3a, t7a);
+        t4 = vec_sub(t0a, t4a);
+        t5 = vec_sub(t1a, t5a);
+        t6 = vec_sub(t2a, t6a);
+        t7 = vec_sub(t3a, t7a);
+        t8a  = pack_eo(rnd14x8(add8(T8,  T12)));
+        t9a  = pack_eo(rnd14x8(add8(T9,  T13)));
+        t10a = pack_eo(rnd14x8(add8(T10, T14)));
+        t11a = pack_eo(rnd14x8(add8(T11, T15)));
+        t12a = pack_eo(rnd14x8(sub8(T8,  T12)));
+        t13a = pack_eo(rnd14x8(sub8(T9,  T13)));
+        t14a = pack_eo(rnd14x8(sub8(T10, T14)));
+        t15a = pack_eo(rnd14x8(sub8(T11, T15)));
+
+        T4  = add8(mul8(t4, k15137), mul8(t5, k6270));      /* C t4a  */
+        T5  = sub8(mul8(t4, k6270),  mul8(t5, k15137));     /* C t5a  */
+        T6  = sub8(mul8(t7, k15137), mul8(t6, k6270));      /* C t6a  */
+        T7  = add8(mul8(t7, k6270),  mul8(t6, k15137));     /* C t7a  */
+        T12 = add8(mul8(t12a, k15137), mul8(t13a, k6270));  /* C t12  */
+        T13 = sub8(mul8(t12a, k6270),  mul8(t13a, k15137)); /* C t13  */
+        T14 = sub8(mul8(t15a, k15137), mul8(t14a, k6270));  /* C t14  */
+        T15 = add8(mul8(t15a, k6270),  mul8(t14a, k15137)); /* C t15  */
+
+        c[0]  = vec_add(t0, t2);
+        c[15] = neg16(vec_add(t1, t3));
+        t2a   = vec_sub(t0, t2);
+        t3a   = vec_sub(t1, t3);
+        c[3]  = pack_eo(neg8(rnd14x8(add8(T4, T6))));
+        c[12] = pack_eo(rnd14x8(add8(T5, T7)));
+        t6    = pack_eo(rnd14x8(sub8(T4, T6)));             /* C t6   */
+        t7    = pack_eo(rnd14x8(sub8(T5, T7)));             /* C t7   */
+        c[1]  = neg16(vec_add(t8a, t10a));
+        c[14] = vec_add(t9a, t11a);
+        t10   = vec_sub(t8a, t10a);
+        t11   = vec_sub(t9a, t11a);
