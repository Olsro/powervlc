+/* Add one 8-wide half-row: dst[j] += (row[j] + 32) >> 6, clipped
+ * (bits == 6 as in itxfm_wrap(16, 6) / itxfm_wrap(32, 6)). */
+static av_always_inline void add_store8_row6(uint8_t *dst, vec_s16 row)
+{
+    const vec_u8  zero = vec_splat_u8(0);
+    const vec_s32 rnd  = vec_sl(vec_splat_s32(1), vec_splat_u32(5));
+    vec_s32 hi = vec_sra(vec_add(vec_unpackh(row), rnd), vec_splat_u32(6));
+    vec_s32 lo = vec_sra(vec_add(vec_unpackl(row), rnd), vec_splat_u32(6));
+    vec_s16 add = vec_packs(hi, lo);
+    vec_u8  pix = unaligned_load(0, dst);
+    vec_s16 p16 = (vec_s16)vec_mergeh(zero, pix);
+    vec_s16 sum = vec_adds(add, p16);
+
+    store8_row(vec_packsu(sum, sum), dst);
+}
