+ITXFM16_ADD(idct_idct_16x16_core_altivec,  idct16_1d_altivec,  idct16_1d_altivec)
+ITXFM16_ADD(iadst_idct_16x16_add_altivec,  iadst16_1d_altivec, idct16_1d_altivec)
+ITXFM16_ADD(idct_iadst_16x16_add_altivec,  idct16_1d_altivec,  iadst16_1d_altivec)
+ITXFM16_ADD(iadst_iadst_16x16_add_altivec, iadst16_1d_altivec, iadst16_1d_altivec)
