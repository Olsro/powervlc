+/* Two-pass 16x16 add, mirroring itxfm_wrapper() with the group /
+ * transpose layout described in the section comment. */
+#define ITXFM16_ADD(name, PA, PB)                                         \
+static void name(uint8_t *dst, ptrdiff_t stride, int16_t *block, int eob) \
+{                                                                         \
+    vec_s16 tmp[2][16], c[16];                                            \
+    int g, h, k, m;                                                       \
+                                                                          \
+    for (g = 0; g < 2; g++) {                                             \
+        for (k = 0; k < 16; k++)                                          \
+            c[k] = vec_ld(k * 32 + g * 16, block);                        \
+        PA(c);                                                            \
+        for (k = 0; k < 16; k++)                                          \
+            tmp[g][k] = c[k];                                             \
+    }                                                                     \
+    memset(block, 0, 16 * 16 * sizeof(int16_t));                          \
+    for (h = 0; h < 2; h++) {                                             \
+        for (m = 0; m < 2; m++) {                                         \
+            for (k = 0; k < 8; k++)                                       \
+                c[8 * m + k] = tmp[m][8 * h + k];                         \
+            transpose8x8_s16(&c[8 * m + 0], &c[8 * m + 1],                \
+                             &c[8 * m + 2], &c[8 * m + 3],                \
+                             &c[8 * m + 4], &c[8 * m + 5],                \
+                             &c[8 * m + 6], &c[8 * m + 7]);               \
+        }                                                                 \
+        PB(c);                                                            \
+        for (k = 0; k < 16; k++)                                          \
+            add_store8_row6(dst + k * stride + 8 * h, c[k]);              \
+    }                                                                     \
+}
