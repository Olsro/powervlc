+    over = vec_or(over, cmpgt_u8(absdiff_u8(p1, p0), i8));
+    over = vec_or(over, cmpgt_u8(absdiff_u8(q1, q0), i8));
+    over = vec_or(over, cmpgt_u8(absdiff_u8(q2, q1), i8));
+    over = vec_or(over, cmpgt_u8(absdiff_u8(q3, q2), i8));
