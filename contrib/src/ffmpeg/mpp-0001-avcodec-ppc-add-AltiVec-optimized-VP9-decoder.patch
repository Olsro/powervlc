+    over = vec_or(over, cmpgt_u8(absdiff_u8(p1, p0), one));
+    over = vec_or(over, cmpgt_u8(absdiff_u8(q1, q0), one));
+    over = vec_or(over, cmpgt_u8(absdiff_u8(q2, q0), one));
+    over = vec_or(over, cmpgt_u8(absdiff_u8(q3, q0), one));
