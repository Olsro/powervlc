+                (vec_u16)vec_mergeh(vec_splat_u8(0), p3));
+    s = add_u8_to_u16(s, p2);
+    s = add_u8_to_u16(s, p1);
+    s = add_u8_to_u16(s, p1);
+    s = add_u8_to_u16(s, p0);
+    s = add_u8_to_u16(s, q0);
+    s = add_u8_to_u16(s, q1);
+    p1f = pack_u16_to_u8(vec_sr(vec_add(s, c4), shift3));
