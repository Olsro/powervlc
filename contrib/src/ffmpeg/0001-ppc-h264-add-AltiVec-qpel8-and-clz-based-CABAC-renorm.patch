+    LOAD_ZERO;
+    const vec_s16 v20ss = vec_sl(vec_splat_s16(5),vec_splat_u16(2));
+    const vec_u32 v10ui = vec_splat_u32(10);
+    const vec_s16 v5ss = vec_splat_s16(5);
+    const vec_s16 v1ss = vec_splat_s16(1);
+    const vec_s32 v512si = vec_sl(vec_splat_s32(1),vec_splat_u32(9));
+    const vec_u32 v16ui = vec_sl(vec_splat_u32(1),vec_splat_u32(4));
+    const vec_u8 mperm = (const vec_u8)
+        {0x00, 0x04, 0x01, 0x05, 0x02, 0x06, 0x03, 0x07,
+         0x08, 0x0C, 0x09, 0x0D, 0x0A, 0x0E, 0x0B, 0x0F};
+
+    int16_t *tmpbis = tmp;
+
+    vec_u8 w;
+    vec_s16 srcP0A, srcP1A, srcP2A, srcP3A, srcM1A, srcM2A,
+            sum1A, sum2A, sum3A, pp1A, pp2A, psumA;
+
+    vec_s16 tmpM1ss, tmpM2ss, tmpP0ss, tmpP1ss, tmpP2ss;
+
+    src -= (2 * srcStride);
+    for (i = 0 ; i < 13 ; i ++) {
+        w = vec_perm(vec_ld(-2, src), vec_ld(13, src), vec_lvsl(-2, src));
+
+        srcM2A = (vec_s16) VEC_MERGEH(zero_u8v, w);
+        srcM1A = (vec_s16) VEC_MERGEH(zero_u8v, vec_sld(w, w, 1));
+        srcP0A = (vec_s16) VEC_MERGEH(zero_u8v, vec_sld(w, w, 2));
+        srcP1A = (vec_s16) VEC_MERGEH(zero_u8v, vec_sld(w, w, 3));
+        srcP2A = (vec_s16) VEC_MERGEH(zero_u8v, vec_sld(w, w, 4));
+        srcP3A = (vec_s16) VEC_MERGEH(zero_u8v, vec_sld(w, w, 5));
+
+        sum1A = vec_adds(srcP0A, srcP1A);
+        sum2A = vec_adds(srcM1A, srcP2A);
+        sum3A = vec_adds(srcM2A, srcP3A);
+
+        pp1A = vec_mladd(sum1A, v20ss, sum3A);
+        pp2A = vec_mladd(sum2A, v5ss, zero_s16v);
+        psumA = vec_sub(pp1A, pp2A);
+
+        vec_st(psumA, 0, tmp);
+
+        src += srcStride;
+        tmp += tmpStride; /* int16_t*, and stride is 8, so it's OK here */
+    }
+
+    tmpM2ss = vec_ld(0, tmpbis);
+    tmpbis += tmpStride;
+    tmpM1ss = vec_ld(0, tmpbis);
+    tmpbis += tmpStride;
+    tmpP0ss = vec_ld(0, tmpbis);
+    tmpbis += tmpStride;
+    tmpP1ss = vec_ld(0, tmpbis);
+    tmpbis += tmpStride;
+    tmpP2ss = vec_ld(0, tmpbis);
+    tmpbis += tmpStride;
+
+    for (i = 0 ; i < 8 ; i++) {
+        const vec_s16 tmpP3ss = vec_ld(0, tmpbis);
+        const vec_s16 sum1A = vec_adds(tmpP0ss, tmpP1ss);
+        const vec_s16 sum2A = vec_adds(tmpM1ss, tmpP2ss);
+        const vec_s16 sum3A = vec_adds(tmpM2ss, tmpP3ss);
+
+        vec_s32 pp1Ae, pp1Ao, pp2Ae, pp2Ao, pp3Ae, pp3Ao,
+                pp1cAe, pp1cAo, pp32Ae, pp32Ao, sumAe, sumAo,
+                ssumAe, ssumAo;
+        vec_s16 ssum;
+        vec_u8 sumv, sum;
+
+        tmpbis += tmpStride;
+
+        tmpM2ss = tmpM1ss;
+        tmpM1ss = tmpP0ss;
+        tmpP0ss = tmpP1ss;
+        tmpP1ss = tmpP2ss;
+        tmpP2ss = tmpP3ss;
+
+        pp1Ae = vec_mule(sum1A, v20ss);
+        pp1Ao = vec_mulo(sum1A, v20ss);
+        pp2Ae = vec_mule(sum2A, v5ss);
+        pp2Ao = vec_mulo(sum2A, v5ss);
+        pp3Ao = vec_mulo(sum3A, v1ss);
+        pp3Ae = vec_sra((vec_s32)sum3A, v16ui);
+
+        pp1cAe = vec_add(pp1Ae, v512si);
+        pp1cAo = vec_add(pp1Ao, v512si);
+        pp32Ae = vec_sub(pp3Ae, pp2Ae);
+        pp32Ao = vec_sub(pp3Ao, pp2Ao);
+
+        sumAe = vec_add(pp1cAe, pp32Ae);
+        sumAo = vec_add(pp1cAo, pp32Ao);
+        ssumAe = vec_sra(sumAe, v10ui);
+        ssumAo = vec_sra(sumAo, v10ui);
+
+        ssum = vec_packs(ssumAe, ssumAo);
+        sumv = vec_packsu(ssum, ssum);
+        sum = vec_perm(sumv, sumv, mperm);
+
+        ASSERT_ALIGNED8(dst);
+        STORE8_OP(sum, dst);
+
+        dst += dstStride;
+    }
+}
+#endif /* PREFIX_h264_qpel8_hv_lowpass_altivec */
+#endif /* HAVE_BIGENDIAN */
