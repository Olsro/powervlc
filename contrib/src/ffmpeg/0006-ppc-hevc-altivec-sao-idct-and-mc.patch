+/* ======================================================================
+ * Whole-pel: no filter at all, but not a memcpy either -- put shifts into
+ * the 14-bit intermediate, bi adds the other prediction, uni_w weights.
+ * Only put_uni_pixels is a real memcpy, and it stays in C.
+ * ====================================================================== */
+static void FUNC(ff_hevc_put_pel_pixels, BIT_DEPTH)(int16_t *dst, const uint8_t *_src,
+                                                    ptrdiff_t _src_stride, int height,
+                                                    intptr_t mx, intptr_t my, int width)
+{
+    const PIXEL *src = (const PIXEL *)_src;
+    const ptrdiff_t src_stride = _src_stride / sizeof(PIXEL);
+    const vec_u16 sh = (vec_u16){ 14 - BIT_DEPTH, 14 - BIT_DEPTH, 14 - BIT_DEPTH, 14 - BIT_DEPTH,
+                                  14 - BIT_DEPTH, 14 - BIT_DEPTH, 14 - BIT_DEPTH, 14 - BIT_DEPTH };
+    int x, y;
+
+    for (y = 0; y < height; y++) {
+        for (x = 0; x + 8 <= width; x += 8)
+            vec_st(vec_sl(FUNC(mc_load8, BIT_DEPTH)(src + x), (vec_u16)sh), 0, dst + x);
+        for (; x < width; x++)
+            dst[x] = src[x] << (14 - BIT_DEPTH);
+        src += src_stride;
+        dst += MAX_PB_SIZE;
+    }
+}
