+            vec_s16 A = FUNC(mc_load8, BIT_DEPTH)(src + x - 1);
+            vec_s16 B = FUNC(mc_load8, BIT_DEPTH)(src + x + 7);
+            MC_H4(A, B, cv, e, o);
+            MC_MERGE(e, o, lo, hi);
+            vec_st(vec_packs(vec_sra(lo, sh), vec_sra(hi, sh)), 0, dst + x);
+        }
+        for (; x < width; x++)
+            dst[x] = CHROMA_SCALAR(src, 1) >> MC_DSHIFT;
+        src += src_stride;
+        dst += MAX_PB_SIZE;
+    }
