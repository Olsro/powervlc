+            for (t = 0; t < 8; t++)
+                MC_MADD(e, o, FUNC(mc_load8, BIT_DEPTH)(src + x + (t - 3) * src_stride), cv[t]);
+            MC_MERGE(e, o, lo, hi);
+            vec_st(vec_packs(vec_sra(lo, sh), vec_sra(hi, sh)), 0, dst + x);
+        }
+        for (; x < width; x++)
