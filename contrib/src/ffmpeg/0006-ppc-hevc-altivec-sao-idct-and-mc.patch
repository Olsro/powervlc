+    const ptrdiff_t dst_stride = _dst_stride / sizeof(PIXEL);
+    const int8_t *filter = ff_hevc_qpel_filters[my];
+    const int shift = 14 - BIT_DEPTH;
+    const int offset = 1 << (shift - 1);
+    const int mode = mc_store_mode(dst, _dst_stride, BIT_DEPTH > 8);
+    const vec_s32 z = mc_splat32(0);
+    const vec_u32 dsh = mc_usplat32(MC_DSHIFT);
+    const vec_u32 vsh = mc_usplat32(shift);
