+static void FUNC(mc_chroma_h16, BIT_DEPTH)(int16_t *dst, const PIXEL *src,
+                                           ptrdiff_t src_stride, int height,
+                                           const int8_t *filter, int width)
+{
+    const vec_s32 z = mc_splat32(0);
