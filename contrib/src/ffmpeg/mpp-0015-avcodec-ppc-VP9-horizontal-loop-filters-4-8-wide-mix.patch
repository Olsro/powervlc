+    store_u64(r2, dst - 4 + 2 * stride);
+    store_u64(r3, dst - 4 + 3 * stride);
+    store_u64(r4, dst - 4 + 4 * stride);
+    store_u64(r5, dst - 4 + 5 * stride);
