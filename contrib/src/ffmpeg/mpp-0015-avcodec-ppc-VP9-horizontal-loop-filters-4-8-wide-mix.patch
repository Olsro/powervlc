+/*
+ * Transpose an 8x8 block of bytes held in the low 8 lanes of 8 vectors.
+ * After the call, output vector k holds column k of the input in its low 8
+ * lanes, which is exactly the layout filter_core_8 consumes (and the store
+ * expects). This is an involution: applying it again restores the original,
+ * so the same routine serves both the load->core and core->store directions.
+ *
+ * The 3-level merge network packs two transposed columns per intermediate
+ * vector (col 2m in the high half, col 2m+1 in the low half); a vec_sld by
+ * 8 bytes brings the odd column down into its own low half. Verified by
+ * exhaustive simulation of the vec_mergeh/mergel/sld index arithmetic.
+ */
+static av_always_inline void transpose_8x8_u8(vec_u8 *r0, vec_u8 *r1,
+                                              vec_u8 *r2, vec_u8 *r3,
+                                              vec_u8 *r4, vec_u8 *r5,
+                                              vec_u8 *r6, vec_u8 *r7)
+{
+    vec_u8 m1_0 = vec_mergeh(*r0, *r4);
+    vec_u8 m1_1 = vec_mergeh(*r1, *r5);
+    vec_u8 m1_2 = vec_mergeh(*r2, *r6);
+    vec_u8 m1_3 = vec_mergeh(*r3, *r7);
+    vec_u8 m2_0 = vec_mergeh(m1_0, m1_2);
+    vec_u8 m2_1 = vec_mergel(m1_0, m1_2);
+    vec_u8 m2_2 = vec_mergeh(m1_1, m1_3);
+    vec_u8 m2_3 = vec_mergel(m1_1, m1_3);
+    vec_u8 c0 = vec_mergeh(m2_0, m2_2);   /* col0 | col1 */
+    vec_u8 c1 = vec_mergel(m2_0, m2_2);   /* col2 | col3 */
+    vec_u8 c2 = vec_mergeh(m2_1, m2_3);   /* col4 | col5 */
