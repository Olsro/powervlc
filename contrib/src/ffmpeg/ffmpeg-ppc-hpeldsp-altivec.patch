+/* next one assumes that ((line_size % 16) == 0) */
+static void avg_pixels16_x2_altivec(uint8_t *block, const uint8_t *pixels, ptrdiff_t line_size, int h)
+{
+    register int i;
+
+    for (i = 0; i < h; i++) {
+        register vector unsigned char first  = vec_ld(0,  pixels);
+        register vector unsigned char second = vec_ld(16, pixels);
+        register vector unsigned char perm   = vec_lvsl(0, pixels);
+        register vector unsigned char pixelsv1 = vec_perm(first, second, perm);
+        register vector unsigned char pixelsv2 = vec_perm(first, second, vec_add(perm, vec_splat_u8(1)));
+        register vector unsigned char blockv   = vec_ld(0, block);
+
+        vec_st(vec_avg(blockv, vec_avg(pixelsv1, pixelsv2)), 0, block);
+
+        pixels += line_size;
+        block  += line_size;
+    }
+}
