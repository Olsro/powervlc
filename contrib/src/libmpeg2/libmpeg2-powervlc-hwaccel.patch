+/* PowerVLC : enregistre (ou retire, hw==NULL) les callbacks de capture pour le
+ * décodage MPEG-2 accéléré matériel (AppleVA). Cf. mpeg2.h / mpeg2_internal.h. */
+void mpeg2_hwaccel (mpeg2dec_t * mpeg2dec, const mpeg2_hwaccel_t * hw)
+{
+    mpeg2_decoder_t * const decoder = &(mpeg2dec->decoder);
+    if (hw != 0 && hw->mb_begin != 0) {
+	decoder->hw_priv = hw->priv;
+	decoder->hw_mb_begin = hw->mb_begin;
+	decoder->hw_block = hw->block;
+	decoder->hw_mb_end = hw->mb_end;
+    } else {
+	decoder->hw_priv = 0;
+	decoder->hw_mb_begin = 0;
+	decoder->hw_block = 0;
+	decoder->hw_mb_end = 0;
+    }
+}
+
+/* PowerVLC M4 — mode REMPLACEMENT. Quand actif ET la picture est capturée par le
+ * GPU (decoder->hw_capture), on SAUTE l'IDCT (mpeg2_idct_copy/add) et le MC pixel
+ * CPU : on conserve le VLD (get_*_block, position bitstream) et le calcul des pmv
+ * (nécessaires au descripteur HW), mais aucun pixel n'est produit côté logiciel —
+ * c'est le GPU qui décode l'image. Seul jalon qui BAISSE le CPU (M1-M3 = additif).
+ * Flag global (pas de champ struct → évite le piège de rebuild mpeg2_internal.h),
+ * posé par mpeg2_set_hw_replace() depuis libmpeg2.c. ⚠ N'est correct que si TOUTES
+ * les pictures sont capturées (une frame retombée sur CPU aurait des réfs logicielles
+ * corrompues) : réservé au chemin frame-predicted complet, sous option. */
+static int mpeg2_hw_replace = 0;
+void mpeg2_set_hw_replace (int on) { mpeg2_hw_replace = on; }
+
+/* PowerVLC — capture run/level AU FIL de la VLD (chemin materiel).
+ * Mesure au PC-sampling sur l'iBook G3 : 54 % du temps de mpeg2_slice partait
+ * dans le re-balayage des 64 positions du DCTblock par dvddriver_encode_block.
+ * La VLD produit deja (position zigzag, valeur dequantifiee) : on les range ici
+ * au moment du store, le backend les consomme tels quels. Un seul decodeur
+ * materiel a la fois (garanti cote backend) -> globals sans verrou. */
+int16_t mpeg2_hw_rl[68][2];
+int     mpeg2_hw_rl_n = 0;
+int     mpeg2_hw_rl_on = 0;
+static int mpeg2_hw_rl_want = 0;
+void mpeg2_set_hw_rl (int on) { mpeg2_hw_rl_want = on; }
+#define HW_RL_PUT(pos, v) do { if (mpeg2_hw_rl_on && mpeg2_hw_rl_n < 66) { \
+	mpeg2_hw_rl[mpeg2_hw_rl_n][0] = (int16_t)(pos); \
+	mpeg2_hw_rl[mpeg2_hw_rl_n][1] = (int16_t)(v); mpeg2_hw_rl_n++; } } while (0)
+/* Le controle de parite MPEG-2 peut basculer dest[63] APRES la boucle :
+ * resynchroniser la paire 63 sur la valeur finale (zigzag 63 == raster 63
+ * dans les deux ordres de scan). */
+#define HW_RL_FIX63(d) do { if (mpeg2_hw_rl_on) { \
+	if (mpeg2_hw_rl_n > 0 && mpeg2_hw_rl[mpeg2_hw_rl_n-1][0] == 63) \
+	    mpeg2_hw_rl[mpeg2_hw_rl_n-1][1] = (d)[63]; \
+	else if ((d)[63] != 0 && mpeg2_hw_rl_n < 66) { \
+	    mpeg2_hw_rl[mpeg2_hw_rl_n][0] = 63; \
+	    mpeg2_hw_rl[mpeg2_hw_rl_n][1] = (d)[63]; mpeg2_hw_rl_n++; } } } while (0)
+
+/* PowerVLC 2a — classification progressif/entrelacé au niveau HEADER (voir
+ * mpeg2.h). frame_pred_frame_dct est posé par header.c au parse de la picture
+ * coding extension, AVANT tout décodage de slice → disponible et exact à
+ * STATE_PICTURE, y compris si la picture est ensuite droppée. */
+int mpeg2_pic_field_predicted (mpeg2dec_t * mpeg2dec)
+{
+    const mpeg2_decoder_t * decoder = &(mpeg2dec->decoder);
+    return (! decoder->frame_pred_frame_dct)
+        || (decoder->picture_structure != FRAME_PICTURE);
+}
+
+/* MC no-op : le parser calcule pmv (lit le bitstream) mais n'écrit aucun pixel. */
+static void mpeg2_mc_noop (uint8_t * d, const uint8_t * s, int stride, int height)
+{
+    (void) d; (void) s; (void) stride; (void) height;
+}
+static mpeg2_mc_fct * const mpeg2_hw_mc_noop[8] = {
+    mpeg2_mc_noop, mpeg2_mc_noop, mpeg2_mc_noop, mpeg2_mc_noop,
+    mpeg2_mc_noop, mpeg2_mc_noop, mpeg2_mc_noop, mpeg2_mc_noop };
+
