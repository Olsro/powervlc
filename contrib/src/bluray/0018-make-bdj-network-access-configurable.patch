diff --git a/src/libbluray/bdj/java/org/videolan/BDJSocketFactory.java b/src/libbluray/bdj/java/org/videolan/BDJSocketFactory.java
index 55a466aa49..37cbbdaae2 100644
--- a/src/libbluray/bdj/java/org/videolan/BDJSocketFactory.java
+++ b/src/libbluray/bdj/java/org/videolan/BDJSocketFactory.java
@@ -20,14 +20,19 @@
 package org.videolan;
 
 import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
 
 import java.lang.reflect.Constructor;
 import java.lang.reflect.Method;
 
+import java.net.InetAddress;
 import java.net.ServerSocket;
 import java.net.Socket;
 import java.net.SocketImpl;
 import java.net.SocketImplFactory;
+import java.net.SocketAddress;
+import java.net.SocketException;
 
 import java.security.AccessController;
 import java.security.PrivilegedActionException;
@@ -35,6 +40,27 @@ import java.security.PrivilegedExceptionAction;
 
 class BDJSocketFactory implements SocketImplFactory {
 
+    private static class BlockedSocketImpl extends SocketImpl {
+        private IOException denied() {
+            return new IOException("BD-Live network access is disabled");
+        }
+
+        protected void create(boolean stream) throws IOException {}
+        protected void connect(String host, int port) throws IOException { throw denied(); }
+        protected void connect(InetAddress address, int port) throws IOException { throw denied(); }
+        protected void connect(SocketAddress address, int timeout) throws IOException { throw denied(); }
+        protected void bind(InetAddress host, int port) throws IOException { throw denied(); }
+        protected void listen(int backlog) throws IOException { throw denied(); }
+        protected void accept(SocketImpl socket) throws IOException { throw denied(); }
+        protected InputStream getInputStream() throws IOException { throw denied(); }
+        protected OutputStream getOutputStream() throws IOException { throw denied(); }
+        protected int available() throws IOException { return 0; }
+        protected void close() throws IOException {}
+        protected void sendUrgentData(int data) throws IOException { throw denied(); }
+        public Object getOption(int option) throws SocketException { return null; }
+        public void setOption(int option, Object value) throws SocketException {}
+    }
+
     protected static void init() {
         try {
             Socket.setSocketImplFactory(new BDJSocketFactory(false));
@@ -84,6 +110,11 @@ class BDJSocketFactory implements SocketImplFactory {
 
     public SocketImpl createSocketImpl() {
 
+        if (!"YES".equalsIgnoreCase(System.getProperty("org.videolan.bdj.network_access"))) {
+            logger.warning("BD-Live network access is disabled");
+            return new BlockedSocketImpl();
+        }
+
         if (server) {
             logger.error("Xlet tried to create server socket");
             throw new RuntimeException("server sockets disabled");
diff --git a/src/libbluray/bdj/java/org/videolan/Libbluray.java b/src/libbluray/bdj/java/org/videolan/Libbluray.java
index f9201a0be0..63a05c4cfd 100644
--- a/src/libbluray/bdj/java/org/videolan/Libbluray.java
+++ b/src/libbluray/bdj/java/org/videolan/Libbluray.java
@@ -25,6 +25,9 @@ import java.awt.BDToolkit;
 import java.awt.event.KeyEvent;
 import java.awt.event.MouseEvent;
 import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
 import java.lang.reflect.Method;
 import java.util.HashMap;
 import java.util.Map;
@@ -53,6 +56,8 @@ import org.videolan.media.content.PlayerManager;
  */
 public class Libbluray {
 
+    private static final Logger logger = Logger.getLogger(Libbluray.class.getName());
+
     /* hook system properties: make "user.dir" point to current Xlet home directory */
 
     private static boolean booted;
@@ -245,7 +250,8 @@ public class Libbluray {
 
     /* called only from native code */
     private static void init(long nativePointer, String discID, String discRoot,
-                               String persistentRoot, String budaRoot) {
+                               String persistentRoot, String budaRoot,
+                               boolean networkAccess) {
 
         initOnce();
 
@@ -314,6 +320,7 @@ public class Libbluray {
         System.setProperty("mhp.profile.enhanced_broadcast", "YES");
         System.setProperty("mhp.profile.interactive_broadcast", "YES");
         System.setProperty("mhp.profile.internet_access", "YES");
+        System.setProperty("org.videolan.bdj.network_access", networkAccess ? "YES" : "NO");
 
         System.setProperty("mhp.eb.version.major", "1");
         System.setProperty("mhp.eb.version.minor", "0");
@@ -481,7 +488,51 @@ public class Libbluray {
     }
 
     protected static boolean cacheBdRomFile(String path, String cachePath) {
-        return cacheBdRomFileN(nativePointer, path, cachePath) == 0;
+        if (cacheBdRomFileN(nativePointer, path, cachePath) != 0) {
+            return false;
+        }
+
+        /* Several Sony frameworks synchronously start their BD-Live loader
+         * from network.xml. A connection error kills that loader before it
+         * wakes the main Xlet, leaving playback at 00:00 forever. Disable the
+         * loader in the temporary VFS copy when networking is not allowed;
+         * the file on the disc is never modified. */
+        if (!"YES".equalsIgnoreCase(System.getProperty("org.videolan.bdj.network_access")) &&
+            path.toLowerCase().endsWith("network.xml")) {
+            FileInputStream input = null;
+            FileOutputStream output = null;
+            try {
+                File file = new File(cachePath);
+                byte[] data = new byte[(int)file.length()];
+                input = new FileInputStream(file);
+                int offset = 0;
+                while (offset < data.length) {
+                    int count = input.read(data, offset, data.length - offset);
+                    if (count < 0) break;
+                    offset += count;
+                }
+                input.close();
+                input = null;
+
+                String xml = new String(data, 0, offset, "UTF-8");
+                String disabled = xml.replaceAll("(?is)<enable>\\s*true\\s*</enable>",
+                                                 "<enable>false</enable>");
+                if (!disabled.equals(xml)) {
+                    output = new FileOutputStream(file);
+                    output.write(disabled.getBytes("UTF-8"));
+                    output.close();
+                    output = null;
+                    logger.info("Disabled BD-Live in cached " + path);
+                }
+            } catch (IOException e) {
+                logger.warning("Failed to disable cached BD-Live configuration: " + e);
+            } finally {
+                try { if (input != null) input.close(); } catch (IOException e) {}
+                try { if (output != null) output.close(); } catch (IOException e) {}
+            }
+        }
+
+        return true;
     }
 
     protected static void setUOMask(boolean menuCallMask, boolean titleSearchMask) {
@@ -692,6 +743,19 @@ public class Libbluray {
         if (num < 0 || (num >= 128))
             throw new IllegalArgumentException("Invalid PSR");
 
+        /* Profile 2 and Profile 5 imply BD-Live. Do not downgrade Profile 5:
+         * authored 3D applications validate both its flag and version 2.4.
+         * Network access is enforced independently by the BD-J sandbox and
+         * connection wrappers. Only ordinary Profile 2 is exposed as the
+         * standard offline Profile 1.1 when network access is disabled. */
+        if (num == RegisterAccess.PSR_PLAYER_PROFILE &&
+            !"YES".equalsIgnoreCase(System.getProperty("org.videolan.bdj.network_access"))) {
+            int nativeProfile = readRegN(nativePointer, 1, num);
+            if ((nativeProfile & 0x00100000) != 0)
+                return nativeProfile;
+            return 0x00010110;
+        }
+
         return readRegN(nativePointer, 1, num);
     }
 
