 /**
+ *  Open BluRay disc, reading the blocks through the application while still
+ *  letting libaacs talk to the drive
+ *
+ * @param bd  BLURAY object
+ * @param read_blocks_handle  opaque handle for read_blocks
+ * @param read_blocks  function used to read disc blocks
+ * @param device_path  drive to hand to libaacs, or NULL
+ * @param keyfile_path  optional AACS keyfile
+ * @return 1 on success, 0 if error
+ */
+BD_PUBLIC int bd_open_stream_dev(BLURAY *bd,
+                   void *read_blocks_handle,
+                   int (*read_blocks)(void *handle, void *buf, int lba, int num_blocks),
+                   const char *device_path,
+                   const char *keyfile_path);
