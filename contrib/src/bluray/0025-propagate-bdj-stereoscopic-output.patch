From: PowerVLC <powervlc@localhost>
Date: Sun, 6 Sep 2026 15:30:00 +0200
Subject: [PATCH] bdj: propagate stereoscopic presentation state through PSR22

Profile-5 applications choose the presentation mode through the HAVi video
configuration. libbluray accepts that configuration but returns one of its
default templates, losing ONE_PLANE, TWO_PLANES or TWOD_OUTPUT and never
updates PSR22. Applications waiting for the register can consequently stall,
and the host cannot distinguish a disc-menu 2D choice from MVC playback.

Reset each new title presentation to 2D, preserve the S3D template selected by
the application, and update PSR22 when that configuration is installed. The
existing register callback then emits BD_EVENT_STEREOSCOPIC_STATUS at the
authoritative point while the mode remains stable across playlists belonging
to the same title.
---
 src/libbluray/bdj/java/org/bluray/ti/selection/TitleContextImpl.java | 8 ++++++++
 src/libbluray/bdj/java/org/havi/ui/HVideoDevice.java                | 19 +++++++++++++++++++
 2 files changed, 27 insertions(+)

diff --git a/src/libbluray/bdj/java/org/havi/ui/HVideoDevice.java b/src/libbluray/bdj/java/org/havi/ui/HVideoDevice.java
--- a/src/libbluray/bdj/java/org/havi/ui/HVideoDevice.java
+++ b/src/libbluray/bdj/java/org/havi/ui/HVideoDevice.java
@@ -23,2 +23,4 @@
 import org.blurayx.s3d.ui.HVideoConfigTemplateS3D;
+import org.blurayx.s3d.ui.S3DProperty;
+import org.videolan.Libbluray;
 import org.blurayx.uhd.ui.HVideoConfigurationTemplateUHD;
@@ -58,4 +60,10 @@ public class HVideoDevice extends HScreenDevice {
         for (int i = 0; i < hvcArray.length; i++)
             if (hvct.match(hvcArray[i]) > score)
                 hvc = hvcArray[i];
+
+        /* Preserve the S3D property requested by the application. The
+         * stock configuration array otherwise loses the requested output
+         * mode when it returns one of its default configurations. */
+        if (hvc != null && hvct instanceof HVideoConfigTemplateS3D)
+            return new HVideoConfiguration(hvct);
         return hvc;
@@ -78,5 +86,16 @@ public class HVideoDevice extends HScreenDevice {
     public boolean setVideoConfiguration(HVideoConfiguration hvc)
             throws SecurityException, HPermissionDeniedException, HConfigurationException {
         this.hvc = hvc;
+        HVideoConfigTemplate template = hvc.getConfigTemplate();
+        if (template instanceof HVideoConfigTemplateS3D) {
+            Object mode = ((HVideoConfigTemplateS3D)template)
+                    .getPreferenceObject(HVideoConfigTemplateS3D.S3D);
+            if (mode == S3DProperty.ONE_PLANE ||
+                    mode == S3DProperty.TWO_PLANES) {
+                Libbluray.writePSR(22, 1, 1);
+            } else if (mode == S3DProperty.TWOD_OUTPUT) {
+                Libbluray.writePSR(22, 0, 1);
+            }
+        }
         return true;
     }
diff --git a/src/libbluray/bdj/java/org/bluray/ti/selection/TitleContextImpl.java b/src/libbluray/bdj/java/org/bluray/ti/selection/TitleContextImpl.java
--- a/src/libbluray/bdj/java/org/bluray/ti/selection/TitleContextImpl.java
+++ b/src/libbluray/bdj/java/org/bluray/ti/selection/TitleContextImpl.java
@@ -39,2 +39,3 @@ import org.videolan.BDJListeners;
 import org.videolan.BDJListeners;
+import org.videolan.Libbluray;
 import org.videolan.Logger;
@@ -67,4 +68,11 @@ public class TitleContextImpl implements TitleContext {
     public void start(Title title, boolean restart) throws SecurityException {
         logger.info("start(" + title.getName() + ", restart=" + restart + ")");
 
+        /* Every new title presentation starts in 2D. Profile-5 applications
+         * request ONE_PLANE or TWO_PLANES through HVideoDevice when they
+         * actually want stereoscopic output. Keep the mode across playlist
+         * changes inside one title. */
+        if (this.title == null || !title.equals(this.title))
+            Libbluray.writePSR(22, 0, 1);
+
         SecurityManager sm = System.getSecurityManager();
