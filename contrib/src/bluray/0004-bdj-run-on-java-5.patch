+
+    /*
+     * Java 5 only. FileSystem declared two abstract methods there that Java 6
+     * dropped or reshaped, and a concrete subclass must implement both or the
+     * class cannot be instantiated (AbstractMethodError). They are compiled
+     * against a Java 6 rt.jar, where the delegate has neither, so the delegation
+     * goes through reflection; on Java 6+ these override nothing and are dead
+     * code. See contrib/src/bluray/rules.mak for the Java 5 target rationale.
+     */
+    private static java.lang.reflect.Method lookup(Class cls, String name,
+                                                   Class[] sig) {
+        while (cls != null) {
+            try {
+                java.lang.reflect.Method m = cls.getDeclaredMethod(name, sig);
+                m.setAccessible(true);
+                return m;
+            } catch (Throwable t) {
+                cls = cls.getSuperclass();
+            }
+        }
+        return null;
+    }
+
+    /* Java 5: checkAccess(File, boolean write); Java 6: checkAccess(File, int) */
+    public boolean checkAccess(File f, boolean write) {
+        java.lang.reflect.Method m = lookup(fs.getClass(), "checkAccess",
+                new Class[] { File.class, Boolean.TYPE });
+        if (m == null) {
+            return false;
+        }
+        try {
+            return ((Boolean)m.invoke(fs,
+                    new Object[] { f, Boolean.valueOf(write) })).booleanValue();
+        } catch (Throwable t) {
+            return false;
+        }
+    }
+
+    /* Java 5 only: gone from FileSystem in Java 6. */
+    public boolean deleteOnExit(File f) {
+        java.lang.reflect.Method m = lookup(fs.getClass(), "deleteOnExit",
+                new Class[] { File.class });
+        if (m == null) {
+            return false;
+        }
+        try {
+            return ((Boolean)m.invoke(fs, new Object[] { f })).booleanValue();
+        } catch (Throwable t) {
+            return false;
+        }
+    }
 }
