+                } catch (InterruptedException t) {
+                    logger.error("Error joining watchdog thread: " + t);
+                }
+            }
         }
 
         public synchronized void startAction(Object action) {
--- a/src/libbluray/bdj/java-j2se/org/videolan/PortingHelper.java
+++ b/src/libbluray/bdj/java-j2se/org/videolan/PortingHelper.java
@@ -39,11 +39,23 @@ public class PortingHelper {
     public static void stopThreadGroup(ThreadGroup t) {
         try {
             ThreadGroup.class.getMethod("stop", new Class[0]).invoke(t, new Object[0]);
+            return;
         } catch (NoSuchMethodException e) {
-            // ignore
+            // ThreadGroup.stop() was removed in recent JDKs. Fall through and
+            // make a best-effort stop request for each platform thread.
         } catch (IllegalAccessException e) {
-            // ignore
+            // Fall through to the per-thread implementation.
         } catch (InvocationTargetException e) {
-            // ignore
+            // Fall through to the per-thread implementation.
+        }
+
+        Thread[] threads = new Thread[Math.max(1, t.activeCount() + 1)];
+        while (t.enumerate(threads, true) == threads.length) {
+            threads = new Thread[threads.length * 2];
+        }
+        for (int i = 0; i < threads.length; i++) {
+            if ((threads[i] != null) && (threads[i] != Thread.currentThread())) {
+                stopThread(threads[i]);
+            }
         }
     }
--- a/src/libbluray/bdj/java/org/videolan/BDJXletContext.java
