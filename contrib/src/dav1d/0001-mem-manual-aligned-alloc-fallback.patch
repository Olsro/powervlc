--- dav1d.orig/src/mem.h	2026-07-16 04:13:50
+++ dav1d/src/mem.h	2026-07-16 04:14:08
@@ -30,6 +30,7 @@
 
 #define TRACK_HEAP_ALLOCATIONS 0
 
+#include <stdint.h>
 #include <stdlib.h>
 
 #if defined(_WIN32) || HAVE_MEMALIGN
@@ -101,15 +102,24 @@
     // must be an integral multiple of alignment.
     return aligned_alloc(align, ROUND_UP(sz, align));
 #else
-#error No aligned allocation functions are available
+    // No aligned allocator in libc (e.g. Mac OS X < 10.6): over-allocate
+    // and stash the malloc pointer right below the aligned area.
+    void *base = malloc(sz + align + sizeof (void *));
+    if (!base) return NULL;
+    uintptr_t aligned = ((uintptr_t)base + sizeof (void *) + align - 1)
+                        & ~(uintptr_t)(align - 1);
+    ((void **)aligned)[-1] = base;
+    return (void *)aligned;
 #endif
 }
 
 static inline void dav1d_free_aligned_internal(void *ptr) {
 #ifdef _WIN32
     _aligned_free(ptr);
-#else
+#elif HAVE_POSIX_MEMALIGN || HAVE_MEMALIGN || HAVE_ALIGNED_ALLOC
     free(ptr);
+#else
+    if (ptr) free(((void **)ptr)[-1]);
 #endif
 }
 
