@@ -581,6 +581,18 @@
     struct crystalhd_user *uc = NULL;
     user_addr_t           ua = NULL;
     int                   error = -1;
+
+    /* A 32-bit kext cannot serve a 64-bit process. Its user addresses live
+     * far above the 4 GB this kernel can reach, and letting the request
+     * through does not merely fail: it corrupts kernel memory and panics the
+     * machine a moment later (observed on 10.6.8, page fault at 0x35 with an
+     * unrelated thread on the stack). Refuse it cleanly instead -- 64-bit
+     * callers need the x86_64 build of this kext, which only loads on a
+     * 64-bit kernel anyway. */
+    if (sizeof(void *) == 4 && proc_is64bit(p)) {
+        IOLog("BroadcomCrystalHD: refusing a 64-bit process\n");
+        return EINVAL;
+    }
     
     if (!adp) {
         IOLog("Invalid adp \n");
