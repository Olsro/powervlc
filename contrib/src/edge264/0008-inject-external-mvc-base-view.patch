+int edge264_inject_external_base(Edge264Decoder *dec,
+		const uint8_t *const samples[3], const int strides[3]) {
+	if (dec == NULL || samples == NULL || strides == NULL ||
+		!samples[0] || !samples[1] || !samples[2])
+		return EINVAL;
+	if (dec->n_threads)
+		pthread_mutex_lock(&dec->lock);
+	int ret = EINVAL;
+	int pic = dec->currPic;
+	if (dec->external_base && pic >= 0 &&
+		!(dec->non_base_frames >> pic & 1) && dec->samples_buffers[pic]) {
+		uint8_t *dstY = dec->samples_buffers[pic];
+		uint8_t *dstCb = dstY + dec->plane_size_Y;
+		uint8_t *dstCr = dstCb + (dec->out.stride_C >> 1);
+		for (int y = 0; y < dec->out.height_Y; ++y)
+			memcpy(dstY + y * dec->out.stride_Y,
+			       samples[0] + y * strides[0], dec->out.width_Y);
+		for (int y = 0; y < dec->out.height_C; ++y) {
+			memcpy(dstCb + y * dec->out.stride_C,
+			       samples[1] + y * strides[1], dec->out.width_C);
+			memcpy(dstCr + y * dec->out.stride_C,
+			       samples[2] + y * strides[2], dec->out.width_C);
+		}
+		dec->remaining_mbs[pic] = 0;
+		dec->next_deblock_addr[pic] = INT_MAX;
+		dec->last_external_base_frame_id = dec->FrameIds[pic];
+		unset_currPic(dec);
+		bump_frame(dec, 0, 0);
+		ret = 0;
+	}
+	if (dec->n_threads) {
+		/* ready_frames() is a DPB-slot mask, not a worker-task mask. Using it
+		 * here wakes a worker on an uninitialised task whenever the matching
+		 * frame bit is set. Re-evaluate the actual pending task dependencies. */
+		dec->ready_tasks = ready_tasks(dec);
+		pthread_cond_broadcast(&dec->task_ready);
+		pthread_mutex_unlock(&dec->lock);
+	}
+	return ret;
+}
