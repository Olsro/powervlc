+void edge264_set_external_base(Edge264Decoder *dec, int enabled) {
+	if (dec == NULL)
+		return;
+	if (dec->n_threads)
+		pthread_mutex_lock(&dec->lock);
+	dec->external_base = !!enabled;
+	if (enabled)
+		dec->last_external_base_frame_id = -1;
+	if (dec->n_threads)
+		pthread_mutex_unlock(&dec->lock);
+}
+
+int32_t edge264_get_last_external_base_frame_id(Edge264Decoder *dec) {
+	if (dec == NULL)
+		return -1;
+	if (dec->n_threads)
+		pthread_mutex_lock(&dec->lock);
+	int32_t frame_id = dec->last_external_base_frame_id;
+	if (dec->n_threads)
+		pthread_mutex_unlock(&dec->lock);
+	return frame_id;
+}
