+int edge264_inject_external_base_uyvy(Edge264Decoder *dec,
+		const uint8_t *uyvy, int stride) {
+	if (dec == NULL || uyvy == NULL || stride <= 0)
+		return EINVAL;
+	if (dec->n_threads)
+		pthread_mutex_lock(&dec->lock);
+	int ret = EINVAL;
+	int pic = dec->currPic;
+	if (dec->external_base && pic >= 0 &&
+		!(dec->non_base_frames >> pic & 1) && dec->samples_buffers[pic]) {
+		uint8_t *dstY = dec->samples_buffers[pic];
+		uint8_t *dstCb = dstY + dec->plane_size_Y;
+		uint8_t *dstCr = dstCb + (dec->out.stride_C >> 1);
+		for (int row = 0; row < dec->out.height_Y; ++row) {
+			const uint8_t *restrict src = uyvy + row * stride;
+			uint8_t *restrict dy = dstY + row * dec->out.stride_Y;
+			for (int x = 0; x < dec->out.width_Y; x += 2) {
+				dy[x] = src[2 * x + 1];
+				dy[x + 1] = src[2 * x + 3];
+			}
+		}
+		for (int row = 0; row < dec->out.height_C; ++row) {
+			const uint8_t *restrict a = uyvy + (2 * row) * stride;
+			const uint8_t *restrict b = a + stride;
+			uint8_t *restrict cb = dstCb + row * dec->out.stride_C;
+			uint8_t *restrict cr = dstCr + row * dec->out.stride_C;
+			for (int x = 0; x < dec->out.width_C; ++x) {
+				cb[x] = ((unsigned)a[4 * x] + b[4 * x] + 1) >> 1;
+				cr[x] = ((unsigned)a[4 * x + 2] + b[4 * x + 2] + 1) >> 1;
+			}
+		}
+		dec->remaining_mbs[pic] = 0;
+		dec->next_deblock_addr[pic] = INT_MAX;
+		dec->last_external_base_frame_id = dec->FrameIds[pic];
+		unset_currPic(dec);
+		bump_frame(dec, 0, 0);
+		ret = 0;
+	}
+	if (dec->n_threads) {
+		dec->ready_tasks = ready_tasks(dec);
+		pthread_cond_broadcast(&dec->task_ready);
+		pthread_mutex_unlock(&dec->lock);
+	}
+	return ret;
+}
