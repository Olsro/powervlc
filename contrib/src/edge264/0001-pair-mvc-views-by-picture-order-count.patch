-// MVC base/dependent output is emitted as one Edge264Frame. Pairing by waiting on
-// POC inside get_frame would hold the lagging view's DPB slot and can deadlock
-// deblocking, so the two per-view output queues advance in lockstep here. The host
-// receives and retains the resulting stereo pair atomically.
+// MVC base/dependent output is emitted as one Edge264Frame. The two view DPBs
+// do not necessarily bump in the same order: a typical GOP can make the base
+// queue expose 0,1,2,3... while the dependent queue exposes 0,3,1,2.... Pair
+// the oldest base picture with the dependent picture carrying the same POC;
+// advancing the two FIFO heads in lockstep produces temporal rivalry between
+// the eyes. Queue entries removed from the middle are compacted so the SIMD
+// empty-slot mask remains a contiguous suffix.
+
+static void remove_queued_picture(Edge264Decoder *dec, int view, int index,
+                                  int count) {
+	for (int i = index; i + 1 < count; ++i)
+		dec->get_frame_queue[view][i] = dec->get_frame_queue[view][i + 1];
+	dec->get_frame_queue[view][count - 1] = -1;
+}
 
