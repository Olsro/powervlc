+/* Runs the CFRunLoop the disc arbitration session is scheduled on. Everything
+ * that talks to the run loop (scheduling the session, registering and
+ * unregistering the approval callback) is done here, on this one thread, so the
+ * DA callbacks are serialised exactly as they were by the old serial dispatch
+ * queue.
+ */
+static void *da_event_thread(void *context)
+{
+    MMCDEV *mmc = context;
+
+    /* Publish the run loop, then let iokit_da_init() continue. */
+    pthread_mutex_lock(&mmc->cb_lock);
+    mmc->event_loop = CFRunLoopGetCurrent();
+    DASessionScheduleWithRunLoop(mmc->session, mmc->event_loop,
+                                 kCFRunLoopDefaultMode);
+    DARegisterDiskMountApprovalCallback(mmc->session, NULL,
+                                        iokit_mount_approval_cb, mmc);
+    pthread_cond_signal(&mmc->cb_cond);
+    pthread_mutex_unlock(&mmc->cb_lock);
+
+    /* CFRunLoopRun() would return as soon as the last source goes away, which
+     * happens while tearing down. Loop until CFRunLoopStop() is what ended it.
+     */
+    while (1) {
+        SInt32 reason = CFRunLoopRunInMode(kCFRunLoopDefaultMode, 1.0e10, FALSE);
+        if (reason == kCFRunLoopRunStopped || reason == kCFRunLoopRunFinished) {
+            break;
+        }
+    }
+
+    return NULL;
+}
