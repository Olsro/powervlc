+/*
+ * Counting semaphore, replacing dispatch_semaphore_t.
+ */
+
+static void mmc_sem_signal(MMCDEV *mmc)
+{
+    pthread_mutex_lock(&mmc->sem_lock);
+    mmc->sem_count++;
+    pthread_cond_signal(&mmc->sem_cond);
+    pthread_mutex_unlock(&mmc->sem_lock);
+}
+
+/* Waits for a signal. timeout_sec < 0 waits forever (DISPATCH_TIME_FOREVER).
+ * Returns 0 if the semaphore was signalled, -1 on timeout.
+ */
+static int mmc_sem_wait(MMCDEV *mmc, int timeout_sec)
+{
+    int result = 0;
+    struct timespec deadline;
+
+    if (timeout_sec >= 0) {
+        struct timeval now;
+        gettimeofday(&now, NULL);
+        deadline.tv_sec  = now.tv_sec + timeout_sec;
+        deadline.tv_nsec = now.tv_usec * 1000;
+    }
+
+    pthread_mutex_lock(&mmc->sem_lock);
+    while (mmc->sem_count == 0) {
+        if (timeout_sec < 0) {
+            pthread_cond_wait(&mmc->sem_cond, &mmc->sem_lock);
+        } else if (pthread_cond_timedwait(&mmc->sem_cond, &mmc->sem_lock,
+                                          &deadline) != 0) {
+            result = -1; /* timed out */
+            break;
+        }
+    }
+    if (result == 0) {
+        mmc->sem_count--;
+    }
+    pthread_mutex_unlock(&mmc->sem_lock);
+
+    return result;
+}
