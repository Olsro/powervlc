 BD_PRIVATE int  crypto_aes_cmac_16(const unsigned char *data, const unsigned char *aes_key, unsigned char *cmac) BD_USED;
 
+/*
+ * AES-128-CBC decryption with a reusable cipher handle.
+ *
+ * gcry_cipher_open() is not cheap: besides allocating the handle it runs a
+ * fast poll of the CSPRNG, which costs a getrusage() and a clock() syscall.
+ * The AACS read path opens one handle per aligned unit (6144 bytes), so on a
+ * 30 Mbit/s stream that is about 600 opens a second, purely to set a key that
+ * changes every time. Keep the handle for the lifetime of the AACS object and
+ * only re-key it.
+ */
+struct aacs_cipher_s;
+typedef struct aacs_cipher_s AACS_CIPHER;
+
+BD_PRIVATE AACS_CIPHER *crypto_aacs_cipher_open(void) BD_USED;
+BD_PRIVATE void crypto_aacs_cipher_close(AACS_CIPHER **p_cipher);
+BD_PRIVATE int  crypto_aacs_cipher_decrypt(AACS_CIPHER *cipher, const uint8_t *key,
+                                           uint8_t *out, size_t out_size,
+                                           const uint8_t *in, size_t in_size) BD_USED;
+
 BD_PRIVATE int  crypto_aacs_decrypt(const uint8_t *key, uint8_t *out, size_t out_size, const uint8_t *in, size_t in_size) BD_USED;
 
 BD_PRIVATE int  crypto_aacs_sign(const uint8_t *cert, const uint8_t *priv_key,
--- a/src/libaacs/crypto.c
+++ b/src/libaacs/crypto.c
@@ -270,11 +270,63 @@
 /*
  *
  */
+
+static const uint8_t aacs_iv[16] = { 0x0b, 0xa0, 0xf8, 0xdd, 0xfe, 0xa6, 0x1f, 0xb3,
+                                     0xd8, 0xdf, 0x9f, 0x56, 0x6a, 0x05, 0x0f, 0x78 };
+
+struct aacs_cipher_s {
+    gcry_cipher_hd_t hd;
+};
+
+AACS_CIPHER *crypto_aacs_cipher_open(void)
+{
+    AACS_CIPHER *cipher = calloc(1, sizeof(*cipher));
+    gcry_error_t err;
+
+    if (!cipher)
+        return NULL;
+
+    err = gcry_cipher_open(&cipher->hd, GCRY_CIPHER_AES, GCRY_CIPHER_MODE_CBC, 0);
+    if (err) {
+        LOG_CRYPTO_ERROR(DBG_AACS, "cipher open failed", err);
+        X_FREE(cipher);
+        return NULL;
+    }
+
+    return cipher;
+}
+
+void crypto_aacs_cipher_close(AACS_CIPHER **p_cipher)
+{
+    if (p_cipher && *p_cipher) {
+        gcry_cipher_close((*p_cipher)->hd);
+        X_FREE(*p_cipher);
+    }
+}
 
+int crypto_aacs_cipher_decrypt(AACS_CIPHER *cipher, const uint8_t *key,
+                               uint8_t *out, size_t out_size,
+                               const uint8_t *in, size_t in_size)
+{
+    gcry_error_t err;
+
+    if (!cipher)
+        return crypto_aacs_decrypt(key, out, out_size, in, in_size);
+
+    /* setkey() re-runs the key schedule and setiv() resets the CBC chain, so
+     * the handle carries no state between units. */
+    err = gcry_cipher_setkey(cipher->hd, key, 16);
+    if (err)
+        return err;
+    err = gcry_cipher_setiv(cipher->hd, aacs_iv, 16);
+    if (err)
+        return err;
+
+    return gcry_cipher_decrypt(cipher->hd, out, out_size, in, in_size);
+}
+
 int crypto_aacs_decrypt(const uint8_t *key, uint8_t *out, size_t out_size, const uint8_t *in, size_t in_size)
