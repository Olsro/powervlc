+/*
+ * Adopting an MMC channel opened by the application.
+ *
+ * SCSITaskLib refuses every command unless the caller holds exclusive access,
+ * and exclusive access is exactly that: one owner per drive. On Mac OS X 10.4
+ * that is a hard conflict, because there the same channel is also the only way
+ * to read the disc at all -- Tiger misdetects BD media as a CD with 2352 byte
+ * blocks, so /dev/rdiskN returns EOF and the volume never mounts. The player
+ * therefore opens the drive itself, and hands the interface over here instead
+ * of libaacs opening a second one that could not exist.
+ *
+ * Passing NULL restores the normal behaviour of finding and claiming the drive.
+ */
+static SCSITaskDeviceInterface **s_external_task_interface = NULL;
+
+void aacs_use_external_mmc(void *task_interface)
+{
+    s_external_task_interface = (SCSITaskDeviceInterface **)task_interface;
+}
