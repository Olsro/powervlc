+/**
+ *  Adopt an MMC channel opened by the application (Mac OS X only)
+ *
+ *  SCSITaskLib grants exclusive access to a single owner, so a player that has
+ *  to drive the disc over MMC itself -- the only option on Mac OS X 10.4, where
+ *  BD media is misdetected as a CD and never reaches the filesystem layer --
+ *  cannot let libaacs claim the drive a second time. Call this with the
+ *  SCSITaskDeviceInterface** before opening, and libaacs will use it as is,
+ *  without looking the drive up, unmounting anything, claiming exclusive access
+ *  or releasing any of it on close. Pass NULL to restore normal behaviour.
+ *
+ * @param task_interface  SCSITaskDeviceInterface**, or NULL
+ */
+AACS_PUBLIC void aacs_use_external_mmc(void *task_interface);
+
 AACS_PUBLIC AACS *aacs_init(void);
 
