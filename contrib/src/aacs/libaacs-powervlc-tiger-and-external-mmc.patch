             (*mmc->taskInterface)->Release(mmc->taskInterface);
-            mmc->taskInterface = NULL;
         }
+        mmc->taskInterface = NULL;
 
         if (mmc->mmcInterface) {
             (*mmc->mmcInterface)->Release(mmc->mmcInterface);
