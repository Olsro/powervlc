+         * disc is already unmounted (or was never mounted), so skip the lookup,
+         * DiskArbitration and the exclusive access claim entirely. */
+        BD_DEBUG(DBG_MMC, "Using the MMC channel supplied by the application\n");
+        mmc->taskInterface = s_external_task_interface;
+        mmc->external_task_interface = 1;
+        return 0;
+    }
