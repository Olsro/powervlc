+static int iokit_find_service_matching(MMCDEV *mmc, io_service_t *servp) {
+    /* IOBDServices is what a Blu-ray drive publishes from Mac OS X 10.5 on.
+     * Tiger has no IOBDStorageFamily at all, so the very same drive shows up
+     * under IODVDServices there -- same MMC user client, same CDBs. Both nubs
+     * exist on 10.6+, and IOBDServices is tried first so nothing changes
+     * where it is available. */
+    static const char *const classes[] = { "IOBDServices", "IODVDServices" };
+    unsigned i;
+
+    for (i = 0; i < sizeof(classes) / sizeof(classes[0]); i++) {
+        if (0 == iokit_find_service_class(mmc, classes[i], servp)) {
+            BD_DEBUG(DBG_MMC, "Found the drive as %s\n", classes[i]);
+            return 0;
+        }
+    }
+
+    return -1;
+}
