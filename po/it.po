msgstr "Maschera di debug"

#: modules/codec/avcodec/avcodec.h:104
msgid "Set FFmpeg debug mask"
msgstr "Imposta la maschera di debug di FFmpeg"

#: modules/codec/avcodec/avcodec.h:106
