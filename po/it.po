#: modules/gui/macosx/VLCHelpWindowController.m:49
#: modules/gui/macosx/VLCMainMenu.m:502 modules/gui/macosx/VLCMainMenu.m:607
#: modules/gui/macosx/VLCMainMenu.m:613
#: modules/gui/qt/components/controller.hpp:112 modules/notify/notify.c:333
msgid "Previous"
