#: modules/gui/macosx/VLCMainMenu.m:614
#: modules/gui/qt/components/controller.hpp:112
#: modules/gui/qt/dialogs/sout.cpp:89 modules/notify/notify.c:335
msgid "Next"
msgstr "Successivo"

#: src/libvlc-module.c:1308
msgid "Select the hotkey to use to skip to the next item in the playlist."
msgstr "Scelta del tasto per passare all'elemento successivo della scaletta."

#: src/libvlc-module.c:1309 modules/control/hotkeys.c:414
#: modules/gui/legacy_macosx/VLCLegacyFSPanel.m:259
#: modules/gui/legacy_macosx/VLCLegacyMainWindow.m:1172
#: modules/gui/legacy_macosx/VLCLegacyMenu.m:555
#: modules/gui/legacy_macosx/VLCLegacyMenu.m:865
#: modules/gui/macosx/VLCControlsBarCommon.m:193
