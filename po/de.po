#: src/libvlc-module.c:362 src/video_output/vout_intf.c:257
#: modules/gui/legacy_macosx/VLCLegacyPrefs.m:882
msgid "Always on top"
msgstr "Immer im Vordergrund"

#: src/libvlc-module.c:364
msgid "Always place the video window on top of other windows."
msgstr "Platziert das Videofenster immer über allen anderen Fenstern."

#: src/libvlc-module.c:366
msgid "Enable wallpaper mode"
msgstr "Hintergrundbild Modus aktivieren"

#: src/libvlc-module.c:368
msgid ""
"The wallpaper mode allows you to display the video as the desktop background."
msgstr ""
"Der Wallpapermodus ermöglicht die Anzeige des Videos als Desktophintergrund."

#: src/libvlc-module.c:371
