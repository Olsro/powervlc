msgstr ""

#: src/libvlc-module.c:1253
msgid "Play and stop"
msgstr ""

#: src/libvlc-module.c:1255
msgid "Stop the playlist after each played playlist item."
msgstr ""

#: src/libvlc-module.c:1257
msgid "Play and exit"
msgstr ""

#: src/libvlc-module.c:1259
