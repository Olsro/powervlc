"aspect ratio list."
msgstr ""

#: src/libvlc-module.c:502
msgid "Fix HDTV height"
msgstr "HDTV ਉਚਾਈ ਠੀਕ ਰੋ"

#: src/libvlc-module.c:504
msgid ""
