#: src/libvlc-module.c:165
msgid "Audio desynchronization compensation"
msgstr ""

#: src/libvlc-module.c:167
msgid ""
"This delays the audio output. The delay must be given in milliseconds. This "
"can be handy if you notice a lag between the video and the audio."
msgstr ""

#: src/libvlc-module.c:172
msgid "This selects which plugin to use for audio resampling."
msgstr ""

#: src/libvlc-module.c:174
msgid "Efficient resampling"
msgstr ""

#: src/libvlc-module.c:176
msgid ""
"Use the lightweight band-limited Speex resampler for audio/video clock-drift "
"correction instead of libsamplerate's costlier SINC. The drift ratio stays "
"close to 1.0, so SINC buys no audible quality but eats several percent of a "
"CPU core on older Macs. This only affects drift correction; fixed sample-"
"rate conversion for music (e.g. 44.1 to 48 kHz) is left untouched."
msgstr ""

#: src/libvlc-module.c:183
msgid "Lightweight A/52 (AC-3) decoder"
msgstr ""

#: src/libvlc-module.c:185
#, c-format
msgid ""
"Decode Dolby Digital (A/52) with liba52 instead of libavcodec. Measured on "
"an iBook G3 600 MHz playing a DVD: 68.9 %% of the CPU against 72.3 %% for "
"libavcodec, i.e. about 3.5 points cheaper, AND decoding in floating point "
"where libavcodec falls back to its fixed-point variant on CPUs without SIMD "
"-- so this is both faster and more accurate there. Machines with AltiVec/SSE "
"keep libavcodec, whose vectorised paths cost them nothing."
msgstr ""

#: src/libvlc-module.c:194
msgid ""
"Sets the audio output channels mode that will be used by default if your "
"hardware and the audio stream are compatible."
msgstr ""

#: src/libvlc-module.c:197
msgid "Force S/PDIF support"
msgstr ""

#: src/libvlc-module.c:199
msgid ""
"This option should be used when the audio output can't negotiate S/PDIF "
"support."
msgstr ""

#: src/libvlc-module.c:201
msgid "AC-3 passthrough"
msgstr ""

#: src/libvlc-module.c:203
msgid ""
"Allow AC-3 (Dolby Digital) bitstreams to be sent unchanged to the selected "
"HDMI or S/PDIF device. Enable this only if the connected receiver, "
"television or projector supports AC-3."
msgstr ""

#: src/libvlc-module.c:206
msgid "E-AC-3 passthrough"
msgstr ""

#: src/libvlc-module.c:208
msgid ""
"Allow E-AC-3 (Dolby Digital Plus) bitstreams to be sent unchanged to the "
"selected HDMI device. Enable this only if the connected equipment supports E-"
"AC-3."
msgstr ""

#: src/libvlc-module.c:211
msgid "TrueHD passthrough"
msgstr ""

#: src/libvlc-module.c:213
msgid ""
"Allow Dolby TrueHD and MLP bitstreams to be sent unchanged over an HDMI HBR "
"connection. Enable this only if the connected equipment supports Dolby "
"TrueHD."
msgstr ""

#: src/libvlc-module.c:216
msgid "DTS passthrough"
msgstr ""

#: src/libvlc-module.c:218
msgid ""
"Allow DTS core bitstreams to be sent unchanged to the selected HDMI or S/"
"PDIF device. Enable this only if the connected equipment supports DTS."
msgstr ""

#: src/libvlc-module.c:220
msgid "DTS-HD passthrough"
msgstr ""

#: src/libvlc-module.c:222
msgid ""
"Allow DTS-HD bitstreams to be sent unchanged over an HDMI HBR connection. "
"Enable this only if the connected equipment supports DTS-HD."
msgstr ""

#: src/libvlc-module.c:225
msgid "Force detection of Dolby Surround"
msgstr "Haririza okujumbura okwa Dolby Surround"

#: src/libvlc-module.c:227
msgid ""
"Use this when you know your stream is (or is not) encoded with Dolby "
"Surround but fails to be detected as such. Even if the stream is not "
"actually encoded with Dolby Surround, turning on this option might enhance "
"your experience, especially when combined with the Headphone Channel Mixer."
msgstr ""

