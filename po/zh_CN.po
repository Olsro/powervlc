msgstr "测试"

#: src/libvlc-module.c:151
msgid "Audio gain"
msgstr "音频增益"

#: src/libvlc-module.c:153
msgid "This linear gain will be applied to outputted audio."
msgstr "此处的线性增益将应用到输出音频上。"

