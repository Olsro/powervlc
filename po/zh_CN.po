msgstr "音频 PID"

#: modules/mux/mpeg/ts.c:106
msgid "Assign a fixed PID to the audio stream."
msgstr "分配一个固定的 PID 给音频流。"

#: modules/mux/mpeg/ts.c:107
msgid "SPU PID"
msgstr "SPU PID"

#: modules/mux/mpeg/ts.c:108
