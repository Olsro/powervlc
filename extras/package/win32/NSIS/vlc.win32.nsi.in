;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; NSIS installer script for vlc ;
; (http://nsis.sourceforge.net) ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

!define PRODUCT_NAME "PowerVLC"
; PowerVLC: the installer/product version is PowerVLC's own
; (POWERVLC_VERSION in configure.ac), not the underlying VLC base version.
; The About dialog shows "Forked from VLC @VERSION@".
!define VERSION @POWERVLC_VERSION@
!define PRODUCT_VERSION @POWERVLC_VERSION@
!define PRODUCT_GROUP "PowerVLC"
!define PRODUCT_PUBLISHER "Olsro (PowerVLC)"
; PowerVLC is an unofficial, community fork of VideoLAN's VLC media player.
; The website below is VideoLAN's upstream project site (attribution / docs).
!define PRODUCT_WEB_SITE "https://www.videolan.org/"
; PowerVLC-specific registry root so a real VLC install is never touched.
!define PRODUCT_DIR_REGKEY "Software\Olsro\PowerVLC"
!define PRODUCT_UNINST_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_NAME}"
!define PRODUCT_UNINST_ROOT_KEY "HKLM"
!define PRODUCT_ID "{9cc15c61-2891-4fdb-99ee-3c0529e81665}"

!define MUI_LANGDLL_REGISTRY_ROOT "HKLM"
!define MUI_LANGDLL_REGISTRY_KEY "${PRODUCT_DIR_REGKEY}"
!define MUI_LANGDLL_REGISTRY_VALUENAME "Language"

!define MEMENTO_REGISTRY_ROOT ${PRODUCT_UNINST_ROOT_KEY}
!define MEMENTO_REGISTRY_KEY "${PRODUCT_UNINST_KEY}"

@HAVE_WIN64_TRUE@ !define VLC_64BIT_INSTALLER

ManifestDPIAware true
Unicode true

; PowerVLC: the NPAPI (Mozilla) and ActiveX browser plugins are obsolete —
; unsupported by every modern browser and dropped upstream in VLC 4.0 — so
; PowerVLC does not ship them. Re-enable these defines to include them.
;!define INSTALL_ACTIVEX
;!define INSTALL_MOZILLA

Var ReinstallType
Var ReinstallUninstallBtn
Var PerformUpdate
Var PreviousVersion
Var PreviousVersionState
Var PreviousInstallDir
Var UninstallLog

Var 32bitUninstaller
Var 32bitPath

;;;;;;;;;;;;;;;;;;;;;;;;;
; General configuration ;
;;;;;;;;;;;;;;;;;;;;;;;;;

Name "${PRODUCT_NAME}"
@HAVE_WIN64_FALSE@                   OutFile ..\PowerVLC-${VERSION}-win32.exe
@HAVE_WIN64_TRUE@@HAVE_ARM64_FALSE@  OutFile ..\PowerVLC-${VERSION}-win64.exe
@HAVE_WIN64_TRUE@@HAVE_ARM64_TRUE@   OutFile ..\PowerVLC-${VERSION}-winarm64.exe
InstallDir "$@PROGRAMFILES@\PowerVLC"
!ifdef NSIS_LZMA_COMPRESS_WHOLE
SetCompressor lzma
!else
SetCompressor /SOLID lzma
!endif

SetOverwrite ifdiff
CRCCheck on
BrandingText "${PRODUCT_PUBLISHER}"

InstType "$(Name_InstTypeRecommended)"
InstType "$(Name_InstTypeMinimum)"
InstType "$(Name_InstTypeFull)"

RequestExecutionLevel admin
!addincludedir NSIS
!addplugindir NSIS
!include nsProcess.nsh
!include WinVer.nsh
!include FileFunc.nsh
!include MUI2.nsh
!include Memento.nsh

!insertmacro GetParameters
!insertmacro GetOptions

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; NSIS Modern User Interface configuration ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; MUI Settings
  !define MUI_ABORTWARNING
  !define MUI_ICON "powervlc.ico"
  !define MUI_UNICON "powervlc.ico"
  !define MUI_COMPONENTSPAGE_SMALLDESC

  ; Banner (welcome and finish page) for installer
  !define MUI_WELCOMEFINISHPAGE_BITMAP "NSIS/vlc_branding.bmp"
  ; Banner for uninstaller
  !define MUI_UNWELCOMEFINISHPAGE_BITMAP "NSIS/vlc_branding.bmp"

; Installer pages
  ; Welcome page
    !define MUI_PAGE_CUSTOMFUNCTION_PRE PageFastUpdatePre
    !define MUI_WELCOMEPAGE_TITLE_3LINES
    !insertmacro MUI_PAGE_WELCOME
  ; Optional update page
    Page custom PageReinstall PageLeaveReinstall
  ; License page
    !define MUI_LICENSEPAGE_BUTTON $(^NextBtn)
