diff --git a/src/HTTPDownload.cpp b/src/HTTPDownload.cpp
--- a/src/HTTPDownload.cpp
+++ b/src/HTTPDownload.cpp
@@ -28,1 +29,3 @@
+#ifndef POWERVLC_EXTERNAL_HTTP
 #include <wx/webrequest.h>
+#endif
@@ -42,0 +45,62 @@
+#ifdef POWERVLC_EXTERNAL_HTTP
+
+CHTTPDownloadThread::CHTTPDownloadThread(const wxString& url,
+		const wxString& filename, const wxString& oldfilename,
+		HTTP_Download_File file_id, bool showDialog, bool checkDownloadNewer)
+	: m_url(url), m_tempfile(filename), m_result(-1), m_response(0),
+	  m_error(0), m_file_id(file_id), m_companion(NULL),
+	  m_finishPosted(false)
+{
+	(void)oldfilename;
+	(void)showDialog;
+	(void)checkDownloadNewer;
+	{
+		wxMutexLocker lock(s_allThreadsMutex);
+		s_allThreads.insert(this);
+	}
+	AddDebugLogLineN(logHTTP,
+		CFormat("HTTP download delegated to PowerVLC: %s") % m_url);
+	CallAfter([this]{ FinishAndDestroy(HTTP_Error); });
+}
+
+void CHTTPDownloadThread::FinishAndDestroy(int result)
+{
+	if (m_finishPosted) return;
+	m_finishPosted = true;
+	m_result = result;
+	CMuleInternalEvent evt(wxEVT_CORE_FINISHED_HTTP_DOWNLOAD);
+	evt.SetInt((int)m_file_id);
+	evt.SetExtraInt64(m_result);
+	wxQueueEvent(wxTheApp, (evt).Clone());
+	{
+		wxMutexLocker lock(s_allThreadsMutex);
+		s_allThreads.erase(this);
+	}
+	CallAfter([this]{ delete this; });
+}
+
+void CHTTPDownloadThread::DetachCompanion()
+{
+	m_companion = NULL;
+}
+
+void CHTTPDownloadThread::Stop()
+{
+	FinishAndDestroy(HTTP_Error);
+}
+
+void CHTTPDownloadThread::StopAll()
+{
+	ThreadSet snapshot;
+	{
+		wxMutexLocker lock(s_allThreadsMutex);
+		snapshot = s_allThreads;
+	}
+	for (ThreadSet::iterator it = snapshot.begin(); it != snapshot.end(); ++it)
+		(*it)->Stop();
+}
+
+CHTTPDownloadThread::ThreadSet CHTTPDownloadThread::s_allThreads;
+wxMutex CHTTPDownloadThread::s_allThreadsMutex;
+
+#else
@@ -471,0 +545 @@ wxMutex CHTTPDownloadThread::s_allThreadsMutex;
+#endif // POWERVLC_EXTERNAL_HTTP
diff --git a/src/ExternalConn.cpp b/src/ExternalConn.cpp
