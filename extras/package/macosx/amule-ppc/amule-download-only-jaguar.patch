+++ b/src/ExternalConn.cpp
@@ -2047,2 +2047,18 @@
-			theApp->serverlist->UpdateServerMetFromURL(url);
-			response = new CECPacket(EC_OP_NOOP);
+			#ifdef POWERVLC_EXTERNAL_HTTP
+			// PowerVLC owns the only HTTP/TLS stack in the bundle. Its Lua
+			// controller has already downloaded this file atomically; merge it
+			// into the running daemon instead of starting wxWebRequest.
+			CPath downloaded(thePrefs::GetConfigDir() + "server.met.download");
+			if (theApp->serverlist->LoadServerMet(downloaded)) {
+				theApp->serverlist->SaveServerMet();
+				CPath::RemoveFile(downloaded);
+				response = new CECPacket(EC_OP_NOOP);
+			} else {
+				response = new CECPacket(EC_OP_FAILED);
+				response->AddTag(CECTag(EC_TAG_STRING,
+					wxTRANSLATE("Unable to load the PowerVLC server.met file.")));
+			}
+			#else
+			theApp->serverlist->UpdateServerMetFromURL(url);
+			response = new CECPacket(EC_OP_NOOP);
+			#endif
