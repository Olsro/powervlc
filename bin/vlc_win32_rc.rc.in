#define VERSION_NUMBER @POWERVLC_VERSION_MAJOR@,@POWERVLC_VERSION_MINOR@,@POWERVLC_VERSION_REVISION@,0
#define VERSION_NUMBER_STR "@POWERVLC_VERSION_MAJOR@,@POWERVLC_VERSION_MINOR@,@POWERVLC_VERSION_REVISION@,0"

#include <winuser.h>

VLC_ICON ICON "powervlc.ico"

1 VERSIONINFO
FILETYPE 1
FILEOS 4
PRODUCTVERSION VERSION_NUMBER
FILEVERSION VERSION_NUMBER
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "PowerVLC"
      VALUE "ProductName", "PowerVLC media player"
      VALUE "ProductVersion", VERSION_NUMBER_STR
      VALUE "InternalName", "powervlc"
      VALUE "OriginalFilename", "powervlc.exe"
      VALUE "FileVersion", "@POWERVLC_VERSION@"
      VALUE "FileDescription", "PowerVLC media player"
      VALUE "LegalCopyright", "Copyright \251 @COPYRIGHT_YEARS@ PowerVLC, VideoLAN and VLC Authors"
      VALUE "LegalTrademarks", "VLC media player, VideoLAN and x264 are registered trademarks from VideoLAN"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "vlc.exe.manifest"
